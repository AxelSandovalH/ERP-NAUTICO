# ── Supabase (Project Settings → API / Database) ─────────────────────────────
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<anon / publishable key>"
# SOLO servidor. Altas de usuarios y seed. Nunca con prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY="<service_role key>"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── Base de datos ────────────────────────────────────────────────────────────
# App: rol `erp_app` (sin privilegios, RLS aplica) por el pooler en modo
# transacción (puerto 6543). El usuario del pooler es erp_app.<project-ref>.
DATABASE_URL="postgresql://erp_app.<project-ref>:<password-erp_app>@aws-0-<region>.pooler.supabase.com:6543/postgres"
# Migraciones: usuario `postgres` por conexión directa o pooler en modo sesión (5432).
MIGRATE_DATABASE_URL="postgresql://postgres.<project-ref>:<password-postgres>@aws-0-<region>.pooler.supabase.com:5432/postgres"
