{
  "name": "erp-nautico",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:db": "DATABASE_URL=postgresql://erp_app:erp_app@localhost:54329/erp_nautico MIGRATE_DATABASE_URL=postgresql://postgres:postgres@localhost:54329/erp_nautico sh -c \"prisma migrate deploy && vitest run --config vitest.db.config.mts\"",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "postinstall": "prisma generate",
    "db:local": "docker compose up -d",
    "db:seed:comisiones": "tsx prisma/seed-comisiones.ts",
    "db:seed:nomina": "tsx prisma/seed-nomina.ts",
    "db:storage": "tsx scripts/crear-bucket.ts",
    "stripe:configurar": "tsx scripts/configurar-stripe.ts",
    "procura:conectar": "tsx scripts/conectar-procura.ts",
    "db:seed:finanzas": "tsx prisma/seed-finanzas.ts",
    "db:seed:actividades": "tsx prisma/seed-actividades.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@fullcalendar/core": "^6.1.22",
    "@fullcalendar/daygrid": "^6.1.22",
    "@fullcalendar/interaction": "^6.1.22",
    "@fullcalendar/list": "^6.1.22",
    "@fullcalendar/react": "^6.1.22",
    "@fullcalendar/timegrid": "^6.1.22",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "dotenv": "^18.0.8",
    "lucide-react": "^1.59.0",
    "next": "16.4.2",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "read-excel-file": "^9.3.12",
    "server-only": "^0.0.1",
    "stripe": "^23.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "prisma": "^7.10.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
