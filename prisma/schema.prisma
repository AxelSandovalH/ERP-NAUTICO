generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── IDENTIDAD (sin RLS: se consulta antes de saber el tenant) ───────────────

enum Plan {
  PRUEBA // todo lo disponible, por tiempo limitado
  CONTROL
  GESTION
  ENTERPRISE
}

// Estado del cobro de la suscripción (Stripe). NINGUNA = sin suscripción (prueba o plan asignado a mano).
enum EstadoSuscripcion {
  NINGUNA
  ACTIVA
  PAGO_PENDIENTE // el último cobro falló; Stripe reintenta. Conserva el acceso con aviso.
  CANCELADA // terminó o no se pudo cobrar: sin acceso a los módulos hasta reactivar
}

enum RolUsuario {
  ADMIN
  GERENTE
  VENDEDOR
  OPERACIONES
}

model Tenant {
  id          String   @id @default(cuid())
  slug        String   @unique
  nombre      String
  plan        Plan     @default(PRUEBA)
  // Módulos activos (ids del registro en src/modules/registry.ts). El plan
  // define el conjunto por defecto; se puede ajustar por tenant.
  modulos     String[] @default([])
  moneda      String   @default("MXN")
  // Zona IANA del negocio: define qué día es "hoy" para el calendario y el panel.
  zonaHoraria String   @default("America/Mazatlan")
  activo      Boolean  @default(true)
  creadoEn    DateTime @default(now())

  // Cobro con Stripe: la suscripción manda sobre `plan` mientras exista
  stripeCustomerId     String?           @unique
  stripeSubscriptionId String?           @unique
  estadoSuscripcion    EstadoSuscripcion @default(NINGUNA)
  suscripcionVenceEn   DateTime? // fin del periodo ya pagado
  cancelaAlFinal       Boolean           @default(false) // pidió cancelar: sigue hasta que venza

  usuarios             Usuario[]
  embarcaciones        Embarcacion[]
  tarifas              Tarifa[]
  bloqueos             BloqueoEmbarcacion[]
  clientes             Cliente[]
  reservas             Reserva[]
  pagos                Pago[]
  beneficiarios        Beneficiario[]
  tarifasComision      TarifaComision[]
  comisiones           Comision[]
  abonosComision       AbonoComision[]
  cierresComision      CierreComision[]
  tripulantes          Tripulante[]
  empleados            Empleado[]
  ubicacionAsistencias UbicacionAsistencia[]
  checadas             Checada[]
  diaAsistencias       DiaAsistencia[]
  pagoNominas          PagoNomina[]
  conceptoNominas      ConceptoNomina[]
  cuentas              Cuenta[]
  categorias           Categoria[]
  gastos               Gasto[]
  ingresos             Ingreso[]
  traspasos            Traspaso[]
  ajusteCuentas        AjusteCuenta[]
  arqueoCuentas        ArqueoCuenta[]
  comprobantes         Comprobante[]
  importacionesBanco   ImportacionBanco[]
  movimientosBanco     MovimientoBanco[]
  cierresConciliacion  CierreConciliacion[]

  plantillasTurno   PlantillaTurno[]
  turnosEmpleado    TurnoEmpleado[]
  semanasPublicadas SemanaPublicada[]

  ubicaciones           Ubicacion[]
  articulos             Articulo[]
  movimientosInventario MovimientoInventario[]

  unidadesTransporte UnidadTransporte[]
  traslados          Traslado[]
}

model Usuario {
  id         String     @id @default(cuid())
  tenantId   String
  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email      String     @unique
  nombre     String
  // Id del usuario en Supabase Auth (auth.users.id). Las credenciales viven allá.
  supabaseId String     @unique
  rol        RolUsuario @default(VENDEDOR)
  activo     Boolean    @default(true)
  creadoEn   DateTime   @default(now())

  reservasCreadas Reserva[]     @relation("ReservaCreador")
  beneficiario    Beneficiario?
  tripulante      Tripulante?
  empleado        Empleado?

  @@index([tenantId])
}

// ─── MÓDULO FLOTA ────────────────────────────────────────────────────────────

enum TipoEmbarcacion {
  YATE
  CATAMARAN
  VELERO
  LANCHA
  MOTO_ACUATICA
  PANGA
}

enum EstadoEmbarcacion {
  ACTIVA
  MANTENIMIENTO
  INACTIVA
}

model Embarcacion {
  id                   String            @id @default(cuid())
  tenantId             String
  tenant               Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  nombre               String
  tipo                 TipoEmbarcacion
  capacidad            Int
  esloraPies           Int?
  color                String            @default("#0ea5e9") // color en el calendario
  estado               EstadoEmbarcacion @default(ACTIVA)
  notas                String?
  // "Precio casa": lo mínimo que la empresa debe recibir por un tour. Base de
  // las comisiones PORCENTAJE_BALANCE (venta − costo base). null = sin configurar.
  precioCasaCentavos   Int?
  paxIncluidosCasa     Int?
  extraPaxCasaCentavos Int?
  creadoEn             DateTime          @default(now())

  tarifas          Tarifa[]
  bloqueos         BloqueoEmbarcacion[]
  reservas         Reserva[]
  tarifasComision  TarifaComision[]
  tripulantesFijos TripulanteEmbarcacion[]
  gastos           Gasto[]

  ubicacionInventario Ubicacion?

  @@unique([tenantId, nombre])
  @@index([tenantId])
}

model Tarifa {
  id             String      @id @default(cuid())
  tenantId       String
  tenant         Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  embarcacionId  String
  embarcacion    Embarcacion @relation(fields: [embarcacionId], references: [id], onDelete: Cascade)
  nombre         String // "Tour 4 horas", "Atardecer"
  duracionMin    Int
  precioCentavos Int
  activa         Boolean     @default(true)

  reservas Reserva[]

  @@index([tenantId])
  @@index([embarcacionId])
}

model BloqueoEmbarcacion {
  id            String      @id @default(cuid())
  tenantId      String
  tenant        Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  embarcacionId String
  embarcacion   Embarcacion @relation(fields: [embarcacionId], references: [id], onDelete: Cascade)
  desde         DateTime    @db.Date
  hasta         DateTime    @db.Date // inclusive
  motivo        String

  @@index([tenantId])
  @@index([embarcacionId, desde, hasta])
}

// ─── MÓDULO RESERVAS ─────────────────────────────────────────────────────────

enum EstadoReserva {
  PENDIENTE
  CONFIRMADA
  COMPLETADA
  CANCELADA
}

enum OrigenReserva {
  DIRECTO
  WEB
  AGENCIA
  CONCIERGE
}

enum MetodoPago {
  EFECTIVO
  TARJETA
  TRANSFERENCIA
  OTRO
}

model Cliente {
  id       String   @id @default(cuid())
  tenantId String
  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  nombre   String
  email    String?
  telefono String?
  notas    String?
  creadoEn DateTime @default(now())

  reservas Reserva[]

  @@index([tenantId])
  @@index([tenantId, nombre])
}

// Fecha + horas locales del negocio (minutos desde medianoche) en lugar de
// timestamps: un charter es "el 5 de marzo de 10:00 a 14:00" donde está la
// flota, sin conversión de zona horaria.
model Reserva {
  id             String        @id @default(cuid())
  tenantId       String
  tenant         Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  folio          Int
  embarcacionId  String
  embarcacion    Embarcacion   @relation(fields: [embarcacionId], references: [id])
  clienteId      String
  cliente        Cliente       @relation(fields: [clienteId], references: [id])
  tarifaId       String?
  tarifa         Tarifa?       @relation(fields: [tarifaId], references: [id], onDelete: SetNull)
  fecha          DateTime      @db.Date
  inicioMin      Int
  finMin         Int
  pax            Int
  estado         EstadoReserva @default(PENDIENTE)
  origen         OrigenReserva @default(DIRECTO)
  totalCentavos  Int
  notas          String?
  creadorId      String?
  creador        Usuario?      @relation("ReservaCreador", fields: [creadorId], references: [id], onDelete: SetNull)
  // Quién la vendió / trajo: define a quién se le calcula comisión
  beneficiarioId String?
  beneficiario   Beneficiario? @relation(fields: [beneficiarioId], references: [id], onDelete: SetNull)
  creadoEn       DateTime      @default(now())
  actualizadoEn  DateTime      @updatedAt

  pagos       Pago[]
  comision    Comision?
  tripulantes ReservaTripulante[]
  gastos      Gasto[]
  ingresos    Ingreso[]

  traslados Traslado[]

  @@unique([tenantId, folio])
  @@index([tenantId, fecha])
  @@index([embarcacionId, fecha])
}

model Pago {
  id            String     @id @default(cuid())
  tenantId      String
  tenant        Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  reservaId     String
  reserva       Reserva    @relation(fields: [reservaId], references: [id], onDelete: Cascade)
  montoCentavos Int
  metodo        MetodoPago
  referencia    String?
  pagadoEn      DateTime   @default(now())

  ingreso Ingreso?

  @@index([tenantId])
  @@index([reservaId])
}

// Contador de folios por tenant (se incrementa de forma atómica).
model FolioContador {
  tenantId String @id
  ultimo   Int    @default(0)
}

// ─── MÓDULO TRIPULACIÓN ──────────────────────────────────────────────────────

enum RolTripulante {
  CAPITAN
  MARINERO
  GUIA
  COCINERO
  FOTOGRAFO
  OTRO
}

model Tripulante {
  id        String        @id @default(cuid())
  tenantId  String
  tenant    Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  usuarioId String?       @unique
  usuario   Usuario?      @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  nombre    String
  apellido  String        @default("")
  rol       RolTripulante
  email     String?
  telefono  String?
  activo    Boolean       @default(true)
  notas     String?
  creadoEn  DateTime      @default(now())

  embarcaciones TripulanteEmbarcacion[]
  asignaciones  ReservaTripulante[]
  empleado      Empleado?

  @@index([tenantId])
}

// Embarcaciones fijas de un tripulante (un capitán puede tener más de una)
model TripulanteEmbarcacion {
  tenantId      String
  tripulanteId  String
  tripulante    Tripulante  @relation(fields: [tripulanteId], references: [id], onDelete: Cascade)
  embarcacionId String
  embarcacion   Embarcacion @relation(fields: [embarcacionId], references: [id], onDelete: Cascade)

  @@id([tripulanteId, embarcacionId])
  @@index([tenantId])
}

model ReservaTripulante {
  tenantId     String
  reservaId    String
  reserva      Reserva       @relation(fields: [reservaId], references: [id], onDelete: Cascade)
  tripulanteId String
  tripulante   Tripulante    @relation(fields: [tripulanteId], references: [id], onDelete: Cascade)
  rol          RolTripulante
  // "HH:MM": a qué hora debe presentarse (por defecto 2 h antes de la salida)
  horaLlegada  String?

  @@id([reservaId, tripulanteId])
  @@index([tenantId])
  @@index([tripulanteId])
}

// ─── MÓDULO COMISIONES ───────────────────────────────────────────────────────

enum TipoBeneficiario {
  VENDEDOR
  AGENCIA
  CONCIERGE
  OTRO
}

enum TipoTarifaComision {
  FIJO
  PORCENTAJE
  PORCENTAJE_BALANCE
  SIN
}

enum EstadoComision {
  PENDIENTE
  PAGADA
  CANCELADA
}

// Quien cobra comisiones: un usuario vendedor o un tercero (agencia, concierge…)
model Beneficiario {
  id        String           @id @default(cuid())
  tenantId  String
  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  nombre    String
  tipo      TipoBeneficiario @default(VENDEDOR)
  usuarioId String?          @unique
  usuario   Usuario?         @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  contacto  String?
  activo    Boolean          @default(true)
  creadoEn  DateTime         @default(now())

  tarifas    TarifaComision[]
  reservas   Reserva[]
  comisiones Comision[]
  abonos     AbonoComision[]

  @@unique([tenantId, nombre])
  @@index([tenantId])
}

// Regla de comisión. Con `origen` y/o `embarcacionId` nulos aplica a todo; entre
// varias reglas gana la más específica (origen pesa más que embarcación).
// `valor`: centavos si FIJO; puntos base (1250 = 12.5 %) si PORCENTAJE*.
model TarifaComision {
  id             String             @id @default(cuid())
  tenantId       String
  tenant         Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  beneficiarioId String
  beneficiario   Beneficiario       @relation(fields: [beneficiarioId], references: [id], onDelete: Cascade)
  embarcacionId  String?
  embarcacion    Embarcacion?       @relation(fields: [embarcacionId], references: [id], onDelete: Cascade)
  origen         OrigenReserva?
  tipo           TipoTarifaComision
  valor          Int
  // Desde `umbralPax` pasajeros se usa `valorAlto` en lugar de `valor`
  umbralPax      Int?
  valorAlto      Int?
  activa         Boolean            @default(true)
  creadoEn       DateTime           @default(now())

  @@index([tenantId])
  @@index([beneficiarioId])
}

// Una comisión por reserva
model Comision {
  id             String         @id @default(cuid())
  tenantId       String
  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  reservaId      String         @unique
  reserva        Reserva        @relation(fields: [reservaId], references: [id], onDelete: Cascade)
  beneficiarioId String
  beneficiario   Beneficiario   @relation(fields: [beneficiarioId], references: [id])
  periodo        String // "YYYY-MM", del día del tour
  baseCentavos   Int // total de la reserva sobre el que se calculó
  montoCentavos  Int
  pagadoCentavos Int            @default(0)
  estado         EstadoComision @default(PENDIENTE)
  // Texto de la regla aplicada, para explicar el monto: "12.5 % del balance (Sunseeker 80)"
  regla          String?
  advertencia    String? // p. ej. "Sin precio casa configurado"
  // Monto fijado a mano: el recálculo automático ya no lo toca
  manual         Boolean        @default(false)
  notas          String?
  pagadaEn       DateTime?
  creadoEn       DateTime       @default(now())
  actualizadoEn  DateTime       @updatedAt

  aplicaciones AbonoAplicacion[]

  @@index([tenantId, periodo])
  @@index([beneficiarioId, estado])
}

// Pago a un beneficiario. Se aplica a sus comisiones más antiguas primero.
model AbonoComision {
  id              String       @id @default(cuid())
  tenantId        String
  tenant          Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  beneficiarioId  String
  beneficiario    Beneficiario @relation(fields: [beneficiarioId], references: [id])
  montoCentavos   Int
  metodo          MetodoPago   @default(TRANSFERENCIA)
  referencia      String?
  notas           String?
  fecha           DateTime     @default(now())
  registradoPorId String?

  aplicaciones AbonoAplicacion[]
  gasto        Gasto?

  @@index([tenantId])
  @@index([beneficiarioId])
}

// A qué comisiones se aplicó cada abono (trazabilidad y reversa)
model AbonoAplicacion {
  tenantId      String
  abonoId       String
  abono         AbonoComision @relation(fields: [abonoId], references: [id], onDelete: Cascade)
  comisionId    String
  comision      Comision      @relation(fields: [comisionId], references: [id], onDelete: Cascade)
  montoCentavos Int

  @@id([abonoId, comisionId])
  @@index([tenantId])
  @@index([comisionId])
}

// Un periodo cerrado congela los montos: no se crean, recalculan ni ajustan
// comisiones de ese mes. Los pagos (abonos) siguen permitidos.
model CierreComision {
  id               String    @id @default(cuid())
  tenantId         String
  tenant           Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  periodo          String // "YYYY-MM"
  cerrado          Boolean   @default(true)
  cerradoPorId     String?
  cerradoEn        DateTime  @default(now())
  reabiertoPorId   String?
  reabiertoEn      DateTime?
  motivoReapertura String?

  @@unique([tenantId, periodo])
}

// ─── MÓDULOS NÓMINA Y ASISTENCIA ─────────────────────────────────────────────

enum EsquemaPago {
  FIJO_PERIODO // sueldo fijo por periodo; las faltas se descuentan
  POR_DIA // precio por día; se paga lo que se trabajó
}

enum PeriodicidadPago {
  SEMANAL
  QUINCENAL
  MENSUAL
}

enum TipoChecada {
  ENTRADA
  SALIDA
}

enum EstadoDia {
  TRABAJO
  DESCANSO
  VACACIONES
  INCAPACIDAD
  PERMISO // sin goce de sueldo
  FALTA // injustificada
}

enum EstadoPagoNomina {
  PENDIENTE
  PAGADO
  CANCELADO
}

enum TipoConcepto {
  BONO
  DEDUCCION
}

// Persona a la que se le paga nómina. Puede ser un tripulante, un usuario del
// sistema (administrativo) o ninguno de los dos (limpieza, mantenimiento…).
model Empleado {
  id             String           @id @default(cuid())
  tenantId       String
  tenant         Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  nombre         String
  apellido       String           @default("")
  puesto         String?
  // Con qué usuario entra a checar su asistencia
  usuarioId      String?          @unique
  usuario        Usuario?         @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  tripulanteId   String?          @unique
  tripulante     Tripulante?      @relation(fields: [tripulanteId], references: [id], onDelete: SetNull)
  esquema        EsquemaPago      @default(FIJO_PERIODO)
  // FIJO_PERIODO: sueldo de cada periodo · POR_DIA: precio de cada día trabajado
  sueldoCentavos Int
  periodicidad   PeriodicidadPago @default(QUINCENAL)
  activo         Boolean          @default(true)
  notas          String?
  creadoEn       DateTime         @default(now())

  checadas Checada[]
  dias     DiaAsistencia[]
  pagos    PagoNomina[]

  turnos TurnoEmpleado[]

  traslados Traslado[]

  @@index([tenantId])
}

// Geocerca: lugar desde el cual se acepta una checada
model UbicacionAsistencia {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  nombre      String
  lat         Float
  lng         Float
  radioMetros Int      @default(150)
  activa      Boolean  @default(true)
  creadoEn    DateTime @default(now())

  checadas Checada[]

  @@index([tenantId])
}

model Checada {
  id          String               @id @default(cuid())
  tenantId    String
  tenant      Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  empleadoId  String
  empleado    Empleado             @relation(fields: [empleadoId], references: [id], onDelete: Cascade)
  tipo        TipoChecada
  fecha       DateTime             @default(now())
  // Día local del negocio (zona horaria de la empresa): evita convertir husos al sumar
  dia         DateTime             @db.Date
  ubicacionId String?
  ubicacion   UbicacionAsistencia? @relation(fields: [ubicacionId], references: [id], onDelete: SetNull)
  lat         Float?
  lng         Float?
  distanciaM  Int?
  precisionM  Int?

  @@index([tenantId, dia])
  @@index([empleadoId, dia])
}

// Corrección manual del día: manda sobre lo que digan las checadas
model DiaAsistencia {
  id            String    @id @default(cuid())
  tenantId      String
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  empleadoId    String
  empleado      Empleado  @relation(fields: [empleadoId], references: [id], onDelete: Cascade)
  fecha         DateTime  @db.Date
  estado        EstadoDia
  nota          String?
  resueltoPorId String?
  creadoEn      DateTime  @default(now())

  @@unique([empleadoId, fecha])
  @@index([tenantId, fecha])
}

model PagoNomina {
  id                  String           @id @default(cuid())
  tenantId            String
  tenant              Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  empleadoId          String
  empleado            Empleado         @relation(fields: [empleadoId], references: [id])
  periodoInicio       DateTime         @db.Date
  periodoFin          DateTime         @db.Date // inclusive
  // Copia de las condiciones al generar: un cambio de sueldo no altera pagos viejos
  esquema             EsquemaPago
  sueldoCentavos      Int
  diasPeriodo         Int
  diasTrabajados      Int // trabajo + vacaciones
  diasFalta           Int // falta + permiso sin goce
  diasSinRegistro     Int // sin checada ni corrección: conviene revisarlos
  brutoCentavos       Int
  bonosCentavos       Int              @default(0)
  deduccionesCentavos Int              @default(0)
  netoCentavos        Int
  estado              EstadoPagoNomina @default(PENDIENTE)
  metodo              MetodoPago?
  referencia          String?
  pagadoEn            DateTime?
  notas               String?
  creadoEn            DateTime         @default(now())
  actualizadoEn       DateTime         @updatedAt

  conceptos ConceptoNomina[]
  gasto     Gasto?

  @@unique([empleadoId, periodoInicio, periodoFin])
  @@index([tenantId, periodoInicio])
}

model ConceptoNomina {
  id            String       @id @default(cuid())
  tenantId      String
  tenant        Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  pagoId        String
  pago          PagoNomina   @relation(fields: [pagoId], references: [id], onDelete: Cascade)
  tipo          TipoConcepto
  concepto      String
  montoCentavos Int
  // Lo calcula el sistema (p. ej. descuento por faltas) y se rehace al recalcular
  automatico    Boolean      @default(false)
  notas         String?

  @@index([pagoId])
  @@index([tenantId])
}

// ─── MÓDULOS GASTOS, INGRESOS Y CUENTAS ──────────────────────────────────────

enum Moneda {
  MXN
  USD
}

enum TipoCuenta {
  EFECTIVO
  BANCO
  TARJETA_CREDITO
  PASARELA // Stripe, PayPal, WeTravel…
  OTRA
}

enum TipoCategoria {
  GASTO
  INGRESO
}

enum EstadoMovimiento {
  ACTIVO
  CANCELADO // se conserva el registro pero ya no cuenta en saldos ni totales
}

enum OrigenMovimiento {
  MANUAL
  PAGO_RESERVA
  NOMINA
  COMISION
  INVENTARIO
  TRANSPORTE
}

// Donde está el dinero: caja de efectivo, cuenta de banco, tarjeta, pasarela de pago.
// El saldo no se guarda: se calcula con sus movimientos.
model Cuenta {
  id                   String     @id @default(cuid())
  tenantId             String
  tenant               Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  nombre               String
  tipo                 TipoCuenta @default(BANCO)
  moneda               Moneda     @default(MXN)
  saldoInicialCentavos Int        @default(0)
  activa               Boolean    @default(true)
  notas                String?
  creadoEn             DateTime   @default(now())

  gastos           Gasto[]
  ingresos         Ingreso[]
  traspasosSalida  Traspaso[]     @relation("TraspasoOrigen")
  traspasosEntrada Traspaso[]     @relation("TraspasoDestino")
  ajustes          AjusteCuenta[]
  arqueos          ArqueoCuenta[]

  // Conciliación bancaria: cómo leer el archivo de este banco (se recuerda por cuenta)
  mapeoBanco       Json?
  movimientosBanco MovimientoBanco[]

  importacionesBanco  ImportacionBanco[]
  cierresConciliacion CierreConciliacion[]

  @@unique([tenantId, nombre])
  @@index([tenantId])
}

// Categorías editables por empresa. `clave` marca las que usa el sistema (NOMINA,
// COMISIONES, RESERVAS) para las conexiones automáticas.
model Categoria {
  id       String        @id @default(cuid())
  tenantId String
  tenant   Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tipo     TipoCategoria
  nombre   String
  clave    String?
  activa   Boolean       @default(true)
  orden    Int           @default(0)

  gastos   Gasto[]
  ingresos Ingreso[]

  @@unique([tenantId, tipo, nombre])
  @@unique([tenantId, clave])
  @@index([tenantId])
}

// `montoCentavos` está en la moneda de la cuenta; `montoBaseCentavos` es su equivalente
// en la moneda base de la empresa (al tipo de cambio del momento) para sumar todo junto.
model Gasto {
  id                String           @id @default(cuid())
  tenantId          String
  tenant            Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  concepto          String
  categoriaId       String?
  categoria         Categoria?       @relation(fields: [categoriaId], references: [id], onDelete: SetNull)
  cuentaId          String
  cuenta            Cuenta           @relation(fields: [cuentaId], references: [id])
  montoCentavos     Int
  moneda            Moneda
  tipoCambio        Float? // MXN por USD, solo si la cuenta no está en la moneda base
  montoBaseCentavos Int
  fecha             DateTime         @db.Date
  embarcacionId     String?
  embarcacion       Embarcacion?     @relation(fields: [embarcacionId], references: [id], onDelete: SetNull)
  reservaId         String?
  reserva           Reserva?         @relation(fields: [reservaId], references: [id], onDelete: SetNull)
  proveedor         String?
  notas             String?
  // Para la facturación: ¿hay que pedir factura de este gasto?
  requiereFactura   Boolean          @default(false)
  estado            EstadoMovimiento @default(ACTIVO)
  origen            OrigenMovimiento @default(MANUAL)
  // Gastos que genera el sistema: uno por pago de nómina / por abono de comisión
  pagoNominaId      String?          @unique
  pagoNomina        PagoNomina?      @relation(fields: [pagoNominaId], references: [id], onDelete: SetNull)
  abonoComisionId   String?          @unique
  abonoComision     AbonoComision?   @relation(fields: [abonoComisionId], references: [id], onDelete: SetNull)
  registradoPorId   String?
  canceladoPorId    String?
  canceladoEn       DateTime?
  motivoCancelacion String?
  creadoEn          DateTime         @default(now())

  comprobantes Comprobante[]
  lineaBanco   MovimientoBanco?

  movimientoInventario MovimientoInventario?

  trasladoId String?
  traslado   Traslado? @relation(fields: [trasladoId], references: [id], onDelete: SetNull)

  @@index([tenantId, fecha])
  @@index([cuentaId])
  @@index([embarcacionId])
}

model Ingreso {
  id                String           @id @default(cuid())
  tenantId          String
  tenant            Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  concepto          String
  categoriaId       String?
  categoria         Categoria?       @relation(fields: [categoriaId], references: [id], onDelete: SetNull)
  cuentaId          String
  cuenta            Cuenta           @relation(fields: [cuentaId], references: [id])
  montoCentavos     Int
  moneda            Moneda
  tipoCambio        Float?
  montoBaseCentavos Int
  fecha             DateTime         @db.Date
  reservaId         String?
  reserva           Reserva?         @relation(fields: [reservaId], references: [id], onDelete: SetNull)
  // Cada pago de reserva genera su ingreso (uno solo, aunque se reintente)
  pagoId            String?          @unique
  pago              Pago?            @relation(fields: [pagoId], references: [id], onDelete: SetNull)
  estado            EstadoMovimiento @default(ACTIVO)
  origen            OrigenMovimiento @default(MANUAL)
  // Confirmación de dirección: alguien valida que el dinero de verdad entró
  confirmado        Boolean          @default(false)
  confirmadoPorId   String?
  confirmadoEn      DateTime?
  notas             String?
  registradoPorId   String?
  canceladoPorId    String?
  canceladoEn       DateTime?
  motivoCancelacion String?
  creadoEn          DateTime         @default(now())
  lineaBanco        MovimientoBanco?

  traslado Traslado?

  @@index([tenantId, fecha])
  @@index([cuentaId])
}

// Mover dinero entre cuentas propias: no es gasto ni ingreso.
model Traspaso {
  id                   String            @id @default(cuid())
  tenantId             String
  tenant               Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  origenId             String
  origen               Cuenta            @relation("TraspasoOrigen", fields: [origenId], references: [id])
  destinoId            String
  destino              Cuenta            @relation("TraspasoDestino", fields: [destinoId], references: [id])
  montoOrigenCentavos  Int // en la moneda de la cuenta de origen
  montoDestinoCentavos Int // en la moneda de la cuenta destino (distinto si cambia la moneda)
  tipoCambio           Float?
  fecha                DateTime          @db.Date
  notas                String?
  estado               EstadoMovimiento  @default(ACTIVO)
  registradoPorId      String?
  creadoEn             DateTime          @default(now())
  lineasBanco          MovimientoBanco[]

  @@index([tenantId, fecha])
  @@index([origenId])
  @@index([destinoId])
}

// Cuadre por arqueo: sobrante (+) o faltante (−)
model AjusteCuenta {
  id            String        @id @default(cuid())
  tenantId      String
  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  cuentaId      String
  cuenta        Cuenta        @relation(fields: [cuentaId], references: [id])
  montoCentavos Int // con signo
  motivo        String
  fecha         DateTime      @db.Date
  arqueoId      String?       @unique
  arqueo        ArqueoCuenta? @relation(fields: [arqueoId], references: [id], onDelete: Cascade)
  creadoEn      DateTime      @default(now())

  @@index([tenantId])
  @@index([cuentaId])
}

model ArqueoCuenta {
  id              String        @id @default(cuid())
  tenantId        String
  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  cuentaId        String
  cuenta          Cuenta        @relation(fields: [cuentaId], references: [id])
  fecha           DateTime      @default(now())
  teoricoCentavos Int // lo que el sistema decía que debía haber
  contadoCentavos Int // lo que se contó físicamente
  notas           String?
  realizadoPorId  String?
  ajuste          AjusteCuenta?

  @@index([tenantId])
  @@index([cuentaId, fecha])
}

// Archivo de soporte de un gasto (foto del ticket, PDF). El archivo vive en Supabase
// Storage, en un bucket privado y bajo la carpeta de la empresa.
model Comprobante {
  id             String   @id @default(cuid())
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  gastoId        String
  gasto          Gasto    @relation(fields: [gastoId], references: [id], onDelete: Cascade)
  ruta           String // ruta dentro del bucket: <tenantId>/<gastoId>/<archivo>
  nombreOriginal String
  mime           String
  tamanoBytes    Int
  subidoPorId    String?
  creadoEn       DateTime @default(now())

  @@unique([ruta])
  @@index([tenantId])
  @@index([gastoId])
}

// Preferencias financieras de la empresa (una fila por empresa)
model ConfigFinanzas {
  tenantId              String  @id
  // Moneda base = Tenant.moneda. Tipo de cambio: pesos por dólar
  tipoCambio            Float   @default(17.5)
  cuentaEfectivoId      String?
  cuentaTarjetaId       String?
  cuentaTransferenciaId String?
}

// ─── Conciliación bancaria ───────────────────────────────────────────────────

enum EstadoLinea {
  PENDIENTE
  CONCILIADA
  IGNORADA
}

// Cada archivo de estado de cuenta que se sube
model ImportacionBanco {
  id             String   @id @default(cuid())
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  cuentaId       String
  cuenta         Cuenta   @relation(fields: [cuentaId], references: [id])
  archivo        String
  filas          Int
  nuevas         Int
  duplicadas     Int
  fueraDePeriodo Int      @default(0)
  creadoPorId    String?
  creadoEn       DateTime @default(now())

  lineas MovimientoBanco[]

  @@index([tenantId, cuentaId])
}

// Un renglón del estado de cuenta. Monto con signo en la moneda de la cuenta: − sale, + entra.
model MovimientoBanco {
  id              String            @id @default(cuid())
  tenantId        String
  tenant          Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  cuentaId        String
  cuenta          Cuenta            @relation(fields: [cuentaId], references: [id])
  fecha           DateTime          @db.Date
  descripcion     String
  montoCentavos   Int
  saldoCentavos   Int?
  referencia      String?
  // Identifica el renglón para que subir dos veces el mismo archivo no lo duplique
  huella          String
  estado          EstadoLinea       @default(PENDIENTE)
  // Con qué movimiento del sistema quedó conciliado (uno solo de los tres)
  gastoId         String?           @unique
  gasto           Gasto?            @relation(fields: [gastoId], references: [id], onDelete: SetNull)
  ingresoId       String?           @unique
  ingreso         Ingreso?          @relation(fields: [ingresoId], references: [id], onDelete: SetNull)
  traspasoId      String?
  traspaso        Traspaso?         @relation(fields: [traspasoId], references: [id], onDelete: SetNull)
  conciliadoPorId String?
  conciliadoEn    DateTime?
  importacionId   String?
  importacion     ImportacionBanco? @relation(fields: [importacionId], references: [id], onDelete: SetNull)
  creadoEn        DateTime          @default(now())

  @@unique([cuentaId, huella])
  @@unique([traspasoId, cuentaId])
  @@index([tenantId, cuentaId, estado, fecha])
}

// Un mes conciliado de una cuenta. Mientras exista, sus renglones del banco ya no se tocan.
model CierreConciliacion {
  id                   String   @id @default(cuid())
  tenantId             String
  tenant               Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  cuentaId             String
  cuenta               Cuenta   @relation(fields: [cuentaId], references: [id])
  mes                  String // YYYY-MM
  saldoBancoCentavos   Int
  saldoSistemaCentavos Int
  sinExplicarCentavos  Int
  notas                String?
  cerradoPorId         String?
  cerradoEn            DateTime @default(now())

  @@unique([cuentaId, mes])
  @@index([tenantId])
}

// ─── Horarios ────────────────────────────────────────────────────────────────

enum TipoTurno {
  TURNO
  DESCANSO
  VACACIONES
  INCAPACIDAD
  PERMISO
}

// Turnos tipo ("Mañana 8–16"). Si fin <= inicio, el turno cruza la medianoche.
model PlantillaTurno {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  nombre    String
  inicioMin Int
  finMin    Int
  color     String   @default("#0ea5e9")
  activa    Boolean  @default(true)
  creadoEn  DateTime @default(now())

  turnos TurnoEmpleado[]

  @@unique([tenantId, nombre])
  @@index([tenantId])
}

// Qué hace una persona un día. Los datos del turno se COPIAN de la plantilla: editarla después no mueve lo ya asignado.
model TurnoEmpleado {
  id            String          @id @default(cuid())
  tenantId      String
  tenant        Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  empleadoId    String
  empleado      Empleado        @relation(fields: [empleadoId], references: [id], onDelete: Cascade)
  fecha         DateTime        @db.Date
  tipo          TipoTurno
  plantillaId   String?
  plantilla     PlantillaTurno? @relation(fields: [plantillaId], references: [id], onDelete: SetNull)
  etiqueta      String?
  inicioMin     Int?
  finMin        Int?
  color         String?
  asignadoPorId String?
  actualizadoEn DateTime        @updatedAt

  @@unique([empleadoId, fecha])
  @@index([tenantId, fecha])
}

// Una semana (identificada por su lunes) que el equipo ya puede ver
model SemanaPublicada {
  id             String   @id @default(cuid())
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  semana         DateTime @db.Date
  publicadaPorId String?
  publicadaEn    DateTime @default(now())

  @@unique([tenantId, semana])
  @@index([tenantId])
}

// ─── Inventario ──────────────────────────────────────────────────────────────

enum TipoUbicacion {
  ALMACEN
  EMBARCACION
}

enum TipoMovInventario {
  COMPRA
  CONSUMO
  MERMA
  AJUSTE
  TRASPASO_SALIDA
  TRASPASO_ENTRADA
}

// Dónde está el inventario: una bodega o una embarcación (una por embarcación, creada sola)
model Ubicacion {
  id            String        @id @default(cuid())
  tenantId      String
  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  nombre        String
  tipo          TipoUbicacion
  embarcacionId String?       @unique
  embarcacion   Embarcacion?  @relation(fields: [embarcacionId], references: [id], onDelete: Cascade)
  activa        Boolean       @default(true)
  creadoEn      DateTime      @default(now())

  movimientos MovimientoInventario[]

  @@unique([tenantId, nombre])
  @@index([tenantId])
}

// Un insumo. Las cantidades se guardan en milésimas de la unidad (2.5 L = 2500) para no perder precisión.
model Articulo {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  nombre      String
  unidad      String
  categoria   String?
  // Existencia mínima (suma de todas las ubicaciones); debajo de ella se avisa que hay que reabastecer
  minimoMilli Int      @default(0)
  activo      Boolean  @default(true)
  notas       String?
  creadoEn    DateTime @default(now())

  movimientos MovimientoInventario[]

  @@unique([tenantId, nombre])
  @@index([tenantId])
}

// Libro de movimientos: la existencia de un artículo en una ubicación es la suma de los suyos (+ entra, − sale).
model MovimientoInventario {
  id                    String            @id @default(cuid())
  tenantId              String
  tenant                Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  articuloId            String
  articulo              Articulo          @relation(fields: [articuloId], references: [id])
  ubicacionId           String
  ubicacion             Ubicacion         @relation(fields: [ubicacionId], references: [id])
  tipo                  TipoMovInventario
  cantidadMilli         Int
  // Solo compras: costo por unidad en la moneda base de la empresa
  costoUnitarioCentavos Int?
  fecha                 DateTime          @db.Date
  proveedor             String?
  notas                 String?
  // Une las dos mitades de un traspaso, o los renglones de un mismo conteo físico
  grupoId               String?
  // La compra que se pagó desde una cuenta genera su gasto
  gastoId               String?           @unique
  gasto                 Gasto?            @relation(fields: [gastoId], references: [id], onDelete: SetNull)
  estado                EstadoMovimiento  @default(ACTIVO)
  registradoPorId       String?
  creadoEn              DateTime          @default(now())

  @@index([tenantId, articuloId, ubicacionId])
  @@index([tenantId, fecha])
  @@index([grupoId])
}

// ─── Transporte ──────────────────────────────────────────────────────────────

enum TipoTraslado {
  IDA // hacia la marina
  REGRESO // de regreso al hotel o domicilio
}

enum EstadoTraslado {
  PROGRAMADO
  COMPLETADO
  CANCELADO
}

model UnidadTransporte {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  nombre    String
  placas    String?
  capacidad Int
  activa    Boolean  @default(true)
  notas     String?
  creadoEn  DateTime @default(now())

  traslados Traslado[]

  @@unique([tenantId, nombre])
  @@index([tenantId])
}

// Un traslado de clientes de una reserva (hotel ↔ marina)
model Traslado {
  id             String            @id @default(cuid())
  tenantId       String
  tenant         Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  reservaId      String
  reserva        Reserva           @relation(fields: [reservaId], references: [id], onDelete: Cascade)
  tipo           TipoTraslado
  fecha          DateTime          @db.Date
  horaMin        Int // hora de recogida, minutos desde medianoche
  duracionMin    Int               @default(60)
  origen         String
  destino        String
  pax            Int
  unidadId       String?
  unidad         UnidadTransporte? @relation(fields: [unidadId], references: [id], onDelete: SetNull)
  // El chofer es una persona del equipo (el mismo catálogo de Horarios, Asistencia y Nómina)
  choferId       String?
  chofer         Empleado?         @relation(fields: [choferId], references: [id], onDelete: SetNull)
  // Se cobra aparte de la reserva: no cambia el total de la reserva ni sus comisiones
  precioCentavos Int               @default(0)
  estado         EstadoTraslado    @default(PROGRAMADO)
  notas          String?
  // El ingreso que se creó al registrar el cobro
  ingresoId      String?           @unique
  ingreso        Ingreso?          @relation(fields: [ingresoId], references: [id], onDelete: SetNull)
  creadoPorId    String?
  creadoEn       DateTime          @default(now())
  actualizadoEn  DateTime          @updatedAt

  gastos Gasto[]

  @@index([tenantId, fecha])
  @@index([unidadId, fecha])
  @@index([choferId, fecha])
  @@index([reservaId])
}
